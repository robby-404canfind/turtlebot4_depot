Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Name: Tool Properties
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane: XY
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Topic:
      Value: /map
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Color Scheme: map
    Alpha: 0.7
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: true
    Frames:
      All Enabled: false
      map:
        Value: true
      odom:
        Value: true
      base_link:
        Value: true
  - Class: rviz_default_plugins/RobotModel
    Name: tb4_0 RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /tb4_0/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/LaserScan
    Name: tb4_0 LaserScan
    Enabled: true
    Topic:
      Value: /tb4_0/scan
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 5
    Size (m): 0.03
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 0; 0
  - Class: nav2_rviz_plugins/ParticleCloud
    Name: tb4_0 ParticleCloud
    Enabled: true
    Topic:
      Value: /tb4_0/particle_cloud
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 5
    Color: 0; 255; 0
    Alpha: 1
  - Class: rviz_default_plugins/RobotModel
    Name: tb4_1 RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /tb4_1/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/LaserScan
    Name: tb4_1 LaserScan
    Enabled: true
    Topic:
      Value: /tb4_1/scan
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 5
    Size (m): 0.03
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 0; 0
  - Class: nav2_rviz_plugins/ParticleCloud
    Name: tb4_1 ParticleCloud
    Enabled: true
    Topic:
      Value: /tb4_1/particle_cloud
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 5
    Color: 0; 255; 0
    Alpha: 1
  - Class: rviz_default_plugins/RobotModel
    Name: tb4_2 RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /tb4_2/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/LaserScan
    Name: tb4_2 LaserScan
    Enabled: true
    Topic:
      Value: /tb4_2/scan
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 5
    Size (m): 0.03
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 0; 0
  - Class: nav2_rviz_plugins/ParticleCloud
    Name: tb4_2 ParticleCloud
    Enabled: true
    Topic:
      Value: /tb4_2/particle_cloud
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 5
    Color: 0; 255; 0
    Alpha: 1
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /tb4_0/initialpose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Value: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 45
      X: 0
      Y: 0
Window Geometry:
  Width: 1400
  Height: 900
